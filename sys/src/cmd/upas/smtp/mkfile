smtpd.$O: 	smtpd.h

smtp.$O to.$O: 	smtp.h

smtpd_parse.$O rfc822_parse.$O: rfc822_parse.h smtp.h smtpd.h

clean:V:
	rm -f *.[$OS] [$OS].$TARG $TARG

../common/libcommon.a$O:
	@{ 	
		cd ../common
		mk
	}
